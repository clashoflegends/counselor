# Counselor configuration template.
# Copy this file to properties.config and fill in your values.
# properties.config is gitignored — do not commit it.

#language = en/pt/it
#autoLoad=/path/to/game_xxx.egf
#loadDir=/path/to/folder
#saveDir=/path/to/folder
# Token provided by the game admin when you join a game. Required to upload orders.
#counselorToken=<token provided by admin>
# Your personal Counselor token. Get it from the website (My Counselor Token page) or let Counselor
# fetch it for you on first upload. Identifies your uploads as coming from your account.
#playerToken=<your personal token from the website>
# Automatic crash reporting: if Counselor crashes, a diagnostic report (version, OS, error
# details) is sent to the game server so the GM can investigate without asking for your log file.
# On by default. Set to false to opt out. No personal data or file contents are sent.
#remoteLogging=true
#mail.smtp.server=smtp.example.com
#mail.smtp.port=587
#mail.smtp.user=youruser
#mail.smtp.passwd=yourpassword
#MyEmail=you@example.com
#SendOrderConfirmationPopUp=1
#SendOrderReceiptRequest=0
# Save orders without prompting: skip the Save dialog and write the orders (.rc.egf) straight to the
# standard filename in the same folder as the results (.rr.egf) file. Set to 1 to enable.
#SaveOrdersNoPrompt=0
#OverrideElimination=0
#LookAndFeelTheme=0
#LookAndFeelFontSize=0
#TableRowAdjust=0
#ActionListHeight=107
#splitSize=300
#TableColumnAdjust=0
#TableActionColumnAdjust=0
#filtro.default=0
#SortAllCombos=0
#fogOfWarType=0
#showCityCap=0
#maximizeWindowOnStart=0
#minimizeMapOnStart=0
#ActionsMissingPopup=0
#AutoSaveActions=0
#AutoMoveNextAction=0
#CopyActionsPopUp=0
#CopyActionsOrder=0
#LoadActionsBehavior=clean
#LoadActionsOtherNations=deny
#HexTagStyle=0
#HexTagFrame=0
#MapTiles=2b
#ShowArmyMovPath=0
#drawArmyMovPath=0
#drawScoutOnMap=0
#drawPcPath=0
#KeepPopupOpen=0
#MoveTagTransparency=0
#ShowCharacterPortraits=1
#PortraitsFolder=/path/to/portraits

# Map colours. All are 6-digit hex, no leading '#', and all are set from Settings > Map with a colour
# picker - edit them here only if you want a value the picker will not give you.
# Colour of the border drawn around the hexes an order may target when it has a limited range
# (Settings > Map > Hex Range Color). Default white; an under-stroke of the opposite shade is added
# automatically so the border stays readable over any terrain.
#ColorHexRange=FFFFFF
# Colourblind aids: override the map fill for barbarian-held and unknown-owner cities. Unset = the
# scenario palette's own colours.
#ColorBarbarian=
#ColorUnknown=
# Base tint of the mountain/coordinate map tiles.
#MapColorCoordinate=efefef
